# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/algo"

# Redis (BullMQ Queue)
REDIS_URL="redis://localhost:6379"

# Auth.js v5
AUTH_SECRET="your-32-byte-base64-auth-secret"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GitHub OAuth (Optional for prod)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth (Optional for prod)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Worker Sandbox Configuration
WORKER_CONCURRENCY=2
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_CPU_LIMIT=1.0
